{
  "id_and_class": {
    "theory_title": "El Yo autoposicionante de Fichte",
    "summary": "Fichte fundamenta la conciencia en el Yo autoposicionante, una actividad originaria que está presente inmediatamente a sí misma antes de cualquier escisión entre sujeto y objeto. La experiencia surge cuando esta actividad encuentra una limitación (Anstoß) en sí misma, que el Yo finito articula como sentimiento, sensación, intuición y concepto, produciendo un mundo que le opone resistencia. La autoconciencia plena requiere además ser convocado a la libertad por otros seres racionales.",
    "associated_thinkers": ["Johann Gottlieb Fichte"],
    "category": "Idealism",
    "subcategory": "",
    "core_identity_tagline": "La conciencia como actividad autoposicionante del Yo",
    "classification_tags": ["german idealism", "transcendental idealism", "self-consciousness", "agency", "intersubjectivity"]
  },
  "conceptual_ground": {
    "explanatory_identity_claim": "La conciencia es la actividad autoposicionante del Yo, un acto autorrelacionado (Tathandlung, ‘acto-hecho’) que se sabe a sí mismo sin hacerse objeto. La experiencia fenoménica es esta actividad tal como resulta limitada y contenida.",
    "ontological_status": "Idealismo (trascendental)",
    "mind_body_relationship": "El cuerpo y el mundo externo son puestos por el Yo como el correlato necesario de su propia actividad, y no como una cosa en sí independiente. El único Yo que realmente existe y actúa es finito, empírico y encarnado.",
    "primitive_or_emergent_status": "Primitivo",
    "emergence_type": "No aplicable (el autoposicionamiento es el primer principio presupuesto en todo episodio de conciencia empírica)",
    "subjectivity_and_intentionality": "Toda conciencia de un objeto implica ya una autorrelación implícita y prerreflexiva, que Fichte sostiene que ningún modelo reflexivo o de orden superior puede explicar. La conciencia intencional de objetos surge cuando el Yo pone un no-yo opuesto a sí mismo.",
    "qualia_account": "La dación sensible es el encuentro afectivo del Yo finito con su propia limitación, articulado primero como sentimiento y después como sensación. Las representaciones sentidas como necesarias parecen objetivas; las sentidas como libres aparecen como nuestros propios productos mentales. Cómo exactamente la limitación produce cualidades sensibles concretas sigue siendo oscuro.",
    "ontological_commitments": "El Yo autoposicionante (con el Yo absoluto como abstracción); el no-yo; la limitación (Anstoß); los individuos finitos y encarnados; otros seres racionales que convocan al Yo a la libertad.",
    "epistemic_access": "La reflexión trascendental sobre lo que debe ser cierto de la subjetividad para que la experiencia sea posible, con la presencia de sí del Yo dada en una intuición intelectual no objetivante.",
    "constituents_and_structure": "Tres principios: el Yo se pone a sí mismo; se pone un no-yo que se le opone; y se pone a ambos como limitándose recíprocamente dentro de la conciencia. A partir de ellos Fichte deriva el sentimiento, la sensación, la intuición de cosas, los conceptos, un mundo espaciotemporal y otras personas."
  },
  "mechanism_and_dynamics": {
    "scope_of_consciousness": "Autoconciencia prerreflexiva; conciencia de objetos; sentimiento sensible; agencia y libertad; autoconciencia intersubjetiva.",
    "distinctive_mechanism_or_principle": "Autoposicionamiento limitado por el Anstoß. Una actividad ilimitada no podría tener experiencia determinada, de modo que la experiencia de esto y no de aquello exige que el esfuerzo del Yo encuentre resistencia.",
    "dynamics_of_emergence": "La conciencia es actividad continua, nunca un campo interior estático. La experiencia determinada se construye en una secuencia que va del sentimiento a la sensación, a la intuición y al concepto, a medida que el Yo articula sus límites.",
    "location_and_distribution": "Se localiza en sujetos finitos, encarnados e individuales, única forma en que el Yo existe realmente.",
    "causation_and_functional_role": "La agencia práctica es central: el Yo se esfuerza, encuentra resistencia y actúa, y el conocimiento mismo depende de esta actividad práctica.",
    "integration_or_binding": "La unidad procede del Yo único autoposicionante, una versión radicalizada de la unidad trascendental de la apercepción de Kant, que acompaña a toda representación.",
    "information_flow_or_representation": "La experiencia ordinaria es un sistema de representaciones, clasificadas según vengan acompañadas de un sentimiento de necesidad (el mundo) o de un sentimiento de libertad (los propios pensamientos).",
    "evolutionary_account": "",
    "core_claims_and_evidence": [
      "La conciencia de cualquier cosa presupone la autoconciencia, y esta autorrelación originaria es un acto, no una cosa.",
      "La experiencia determinada exige que la actividad del Yo sea limitada, de modo que el mundo sentido es libertad finita que encuentra resistencia.",
      "El mundo objetivo es puesto por el Yo, lo que elimina la cosa en sí incognoscible de Kant.",
      "La individualidad autoconsciente requiere una convocatoria (Aufforderung) de otro ser racional."
    ],
    "basis_of_belief_or_evidence_type": "Argumento filosófico trascendental."
  },
  "empirics_and_critiques": {
    "testability_status": "Conceptualmente comprobable",
    "known_empirical_interventions_or_tests": "",
    "criticisms_and_tensions": "La explicación es trascendental, no explicativa en sentido científico: no nombra mecanismos neuronales, leyes psicofísicas ni criterios empíricos de la conciencia. El paso de la limitación trascendental a las cualidades sensibles determinadas queda oscuro.",
    "open_questions_and_limitations": "Los intérpretes discuten si el Yo de Fichte es el sujeto empírico individual o un Yo absoluto, suprain­dividual. La respuesta decide si su visión es una teoría de la autoconciencia individual o un idealismo absoluto completo.",
    "ontological_coherence": "Más radical que el idealismo de Kant, pues no se conserva nada fuera del posicionamiento del Yo, y distinta del idealismo de Berkeley, pues el individuo no inventa el mundo a voluntad."
  },
